{
  "name": "otaku-bazaar",
  "version": "4.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "bash scripts/vercel-build.sh",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "admin:grant": "tsx scripts/make-admin.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.890.0",
    "@prisma/client": "~6.19.3",
    "@vercel/blob": "^2.9.0",
    "clsx": "^2.1.1",
    "next": "~15.5.29",
    "react": "~19.1.10",
    "react-dom": "~19.1.10",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "~4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "prisma": "~6.19.3",
    "tailwindcss": "~4.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "~3.2.0"
  },
  "overrides": {
    "postcss": "^8.5.33",
    "undici": "^6.29.1",
    "effect": "^3.22.1",
    "deepmerge-ts": "^8.0.2"
  }
}
