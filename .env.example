# On Vercel, the ONLY required setting is the database, added automatically by Storage → Neon → Connect.
# Everything else is configured in the admin panel (Admin → Integrations / Store settings).
# This file is for running the store on your own computer: copy it to .env.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otaku"

# Local development only: creates demo staff/customer logins (password OtakuDemo123). Never set on Vercel.
SEED_DEMO_ACCOUNTS="true"

# ── Optional overrides (not needed; the admin panel or Vercel provides these) ──
# AUTH_SECRET=""           # 32+ chars. If unset, the store generates one and keeps it in the database.
# APP_URL=""               # Public URL. On Vercel it's detected automatically (incl. your custom domain).
# RESEND_API_KEY=""  MAIL_FROM=""                     # Or set in Admin → Integrations
# GOOGLE_CLIENT_ID="" GOOGLE_CLIENT_SECRET=""         # Or set in Admin → Integrations
# BLOB_READ_WRITE_TOKEN=""                            # Set automatically when you connect Vercel Blob
# NOINDEX="true"                                      # Hide the site from search engines
