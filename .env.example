# Copy to .env for local development. Never commit .env.
# On Vercel, set these in Project → Settings → Environment Variables (see docs/DEPLOY-VERCEL.md).
# Everything here is server-only; nothing is exposed to the browser.

# ── Database (required) ──
# Vercel + Neon integration sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (used for migrations) automatically.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otaku"
# DATABASE_URL_UNPOOLED=""

# ── Site (required in production) ──
# Public URL without trailing slash. On Vercel it falls back to the production domain if unset.
APP_URL="http://localhost:3000"
# 32+ random characters. The app refuses to start in production without it.
AUTH_SECRET=""

# ── First-time setup (Vercel) ──
# Email of the owner account. After that person registers, the next deploy makes them Super Admin. Remove afterwards.
# BOOTSTRAP_ADMIN_EMAIL=""
# "true" to load 84 demo products on the very first setup.
# SEED_DEMO_PRODUCTS="false"

# ── Image uploads ──
# Vercel Blob: connecting a Blob store sets this automatically.
# BLOB_READ_WRITE_TOKEN=""
# Or any S3-compatible bucket (AWS S3, Cloudflare R2…):
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_HOST=""
# Without either, uploads go to public/uploads in development only.

# ── Email via Resend (recommended) ──
# Without it, development prints emails to the console; production records them as skipped.
RESEND_API_KEY=""
MAIL_FROM="The Otaku Bazaar <orders@example.com>"

# ── Google sign-in (optional) ──
# Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Search engines ──
# "true" hides the site from search engines (Vercel preview deployments are hidden automatically).
# NOINDEX="false"

# ── Local development only. Never set on Vercel. ──
SEED_DEMO_ACCOUNTS="true"
