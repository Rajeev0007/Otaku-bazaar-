# Copy to .env and fill in. Never commit .env. Everything here is server-only unless prefixed NEXT_PUBLIC_.

# PostgreSQL (Neon, Supabase, RDS or local). Neon: use the pooled URL here and the direct URL for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otaku"

# Public site URL, used for canonical links, emails and OAuth redirects.
APP_URL="http://localhost:3000"

# 32+ random bytes, used to sign short-lived cookies (OAuth state). Generate: openssl rand -base64 32
AUTH_SECRET=""

# Google login (optional). Redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional email via Resend (optional in development; emails are printed to the console when unset).
RESEND_API_KEY=""
MAIL_FROM="The Otaku Bazaar <orders@example.com>"

# S3-compatible media storage for admin uploads (AWS S3, Cloudflare R2, Backblaze B2...).
# When unset in development, uploads are written to public/uploads.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public host that serves the bucket (CDN), e.g. cdn.theotakubazaar.com
MEDIA_PUBLIC_HOST=""

# Development only: lets the seed create demo staff accounts. Never set in production.
SEED_DEMO_ACCOUNTS="true"
